{
  "name": "keydriver-lite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "跨平台键盘驱动 GUI：读取 VIA 定义文件，可视化改键与自定义菜单配置",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173",
    "desktop": "vite --port 5173 & sleep 3 && open -a \"Google Chrome\" --args --app=http://localhost:5173",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vitest run scripts/smoke.test.ts",
    "check": "node scripts/check-no-hardcode.mjs && node scripts/codemod-spacing.mjs && node scripts/verify-definition-stats.mjs definitions/7-19-Em60_cn.json && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\"",
    "lint": "eslint src --ext .ts,.tsx",
    "electron:dev": "electron .",
    "dev:app": "node scripts/dev-app.mjs",
    "electron:build": "npm run build && electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "app": "npm run build && node scripts/make-app.mjs"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-hid": "^1.0.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "electron": "^44.7.0"
  },
  "build": {
    "appId": "com.keydriver.lite",
    "productName": "KeyDriver Lite",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "afterSign": "scripts/after-sign.mjs",
    "electronLanguages": [
      "en",
      "zh"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "forceCodeSigning": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "asar": true
  }
}
